{
  "name": "zmanim-mcp",
  "version": "0.1.0",
  "description": "MCP server for zmanim, Shabbat times and the Hebrew calendar. Deterministic calculations, no API key.",
  "private": true,
  "type": "module",
  "bin": {
    "zmanim-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hebcal/core": "^6.16.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.162.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zmanim",
    "hebrew-calendar",
    "shabbat",
    "jewish"
  ],
  "homepage": "https://kavana.jonyy.com/mcp/",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonyteubal/zmanim-mcp.git"
  }
}
